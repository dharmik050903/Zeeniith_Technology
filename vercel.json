{
  "buildCommand": "PUPPETEER_CACHE_DIR=\"$PWD/.cache/puppeteer\" npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "PUPPETEER_CACHE_DIR=\"$PWD/.cache/puppeteer\" npm install --legacy-peer-deps",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "zeeniith.in" }],
      "destination": "https://www.zeeniith.in/:path*",
      "permanent": true
    }
  ]
}

